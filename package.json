{
  "name": "haribo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "onboard": "node apps/cli/bin/sil.mjs doctor",
    "sil": "node apps/cli/bin/sil.mjs",
    "mcp:check": "pnpm --filter @sil/mcp run check",
    "mcp:serve": "pnpm --filter @sil/mcp run start",
    "mcp:dev": "pnpm --filter @sil/mcp run dev",
    "mcp:register": "pnpm --filter @sil/mcp run register",
    "mcp:token": "pnpm --filter @sil/mcp run token",
    "db:push": "supabase db push",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && pnpm --filter @sil/notify test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "~24.13.6",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "supabase": "^2.120.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
