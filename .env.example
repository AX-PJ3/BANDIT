# 필요한 키 이름만 적는 파일이에요. 실제 값은 같은 폴더의 .env에 넣어요 (.env는 저장소에 올라가지 않아요).
# `pnpm onboard`를 처음 실행하면 이 파일을 복사해 .env를 만들어 줘요.

# ---------------------------------------------------------------------------
# 팀원: 팀 MCP 서버에 붙을 때만 채워요 (pnpm mcp:register가 읽어요)
# ---------------------------------------------------------------------------
# 팀 MCP 서버 주소. 예: https://sil.example.com/mcp
SIL_MCP_URL=
# 팀 토큰 (정민님에게 Slack DM으로 받아요. 저장소나 채널에 올리지 않아요)
SIL_MCP_TOKEN=

# ---------------------------------------------------------------------------
# 서버를 켜는 곳(호스팅 환경 변수, 또는 내 컴퓨터에서 pnpm mcp:serve)만 채워요
# ---------------------------------------------------------------------------
# Supabase 프로젝트 주소와 공용 키 (대시보드 → Project Settings → API Keys → Publishable key) (SIL-14)
# 비워 두면 DB 없이 켜져요. 위키 도구는 "DB를 연결해 주세요"라고 답해요.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 받아 줄 팀 토큰. '이름:토큰'을 쉼표로 이어요. 만들기: pnpm mcp:token haribo
# 비워 두면 내 컴퓨터(localhost)에서 온 요청만 받아요.
SIL_MCP_TOKENS=

# 서버가 열릴 주소와 포트. 내 컴퓨터는 127.0.0.1, 호스팅은 0.0.0.0 (포트는 호스팅이 정해 주면 그 값)
SIL_MCP_HOST=127.0.0.1
PORT=3333

# 브라우저에서 부를 때 허락할 호스트 이름(쉼표). MCP Inspector처럼 브라우저 도구를 쓸 때만 (보통 비워 둬요)
SIL_MCP_ALLOWED_ORIGINS=

# 로그 양: debug | info | warn | error
LOG_LEVEL=info

# --- 아래는 기능을 붙일 때 담당자가 주석을 풀고 이유와 이슈 번호를 함께 적어요 ---
# LINEAR_API_KEY=      # 사람 연결표 동기화, 이슈 담당자 읽기 (SIL-15, SIL-29)
# ANTHROPIC_API_KEY=   # 바뀐 기준 판단 (SIL-26). GitHub Actions에서는 저장소 Secrets에 넣어요 (SIL-18)
# SLACK_BOT_TOKEN=     # Slack DM 알림 (SIL-33)
