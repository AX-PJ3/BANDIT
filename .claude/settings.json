{
  "permissions": {
    "ask": ["mcp__haribo__save_standard", "mcp__haribo__revert"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/apps/detect/src/t1/hook-preview.ts\""
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/apps/detect/src/t1/hook-conflicts.ts\""
          }
        ]
      },
      {
        "matcher": "mcp__haribo__save_standard",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/apps/detect/src/t1/hook-clear.ts\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__haribo__save_standard",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/apps/detect/src/t1/hook-guard.ts\""
          }
        ]
      }
    ]
  }
}
