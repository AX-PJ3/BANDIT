{
  "name": "@sil/mcp",
  "version": "0.0.0",
  "private": true,
  "description": "팀이 함께 쓰는 MCP 서버 (Streamable HTTP). 위키 도구 + 알리기 도구",
  "type": "module",
  "bin": {
    "sil-mcp": "./bin/sil-mcp.mjs"
  },
  "scripts": {
    "start": "node bin/sil-mcp.mjs",
    "dev": "node --watch src/index.ts",
    "check": "node scripts/check.ts",
    "register": "node scripts/register.ts",
    "token": "node scripts/token.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/server": "^2.3.1",
    "@sil/core": "workspace:*",
    "@sil/notify": "workspace:*",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1"
  }
}
